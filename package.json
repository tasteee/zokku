{
	"name": "zokku",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vite build && node -e \"require('fs').copyFileSync('out/index.html', 'out/404.html')\"",
		"preview": "vite preview",
		"preview:cloudflare": "npm run build && wrangler pages dev out",
		"deploy": "wrangler pages deploy out --project-name zokku",
		"lint": "eslint"
	},
	"dependencies": {
