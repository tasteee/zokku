		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"@fontsource/fraunces": "^5.3.0",
		"@monaco-editor/react": "^4.7.0",
		"@phosphor-icons/react": "^2.1.10",
		"@shikijs/types": "^4.2.0",
		"@tasteee/zest": "0.8.0",
		"@uiw/react-codemirror": "^4.25.10",
		"atomico": "^2.2.0",
		"clsx": "^2.1.1",
		"datass": "^2.1.2",
		"dayjs": "^1.11.21",
		"gray-matter": "^4.0.3",
